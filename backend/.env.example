# ── Local development ───────────────────────────────────────────
# Copy to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local) — leave blank to use SQLite in dev
DATABASE_URL=postgres://buildnest:buildnest@localhost:5432/buildnest

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT lifetimes (minutes / days)
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# ── Production (Render) — set these in Render dashboard, not here ──
# DJANGO_SETTINGS_MODULE=config.settings.prod
# SECRET_KEY=<auto-generated by Render>
# DEBUG=False
# ALLOWED_HOSTS=buildnest-ofsr.onrender.com
# DATABASE_URL=<paste Neon connection string>  e.g. postgresql://user:pass@ep-xxx.neon.tech/buildnest?sslmode=require
# CORS_ALLOWED_ORIGINS=https://buildnest-saas.vercel.app
# JWT_ACCESS_LIFETIME_MIN=60
# JWT_REFRESH_LIFETIME_DAYS=30
